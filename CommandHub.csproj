<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CommandHub</AssemblyName>
    <RootNamespace>CommandHub</RootNamespace>
    <Product>Command hub</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Custom Main (in App.xaml.cs) so Velopack runs before WPF starts. -->
  <PropertyGroup>
    <StartupObject>CommandHub.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CommandHub.Tests/**;docs/**;.superpowers/**" />
    <None Remove="CommandHub.Tests/**;docs/**;.superpowers/**" />
    <Page Remove="CommandHub.Tests/**" />
  </ItemGroup>

</Project>
