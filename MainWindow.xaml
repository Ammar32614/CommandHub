<Window x:Class="CommandHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command hub" Width="1300" Height="780" MinWidth="720" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Bg}"
        FontFamily="{StaticResource TextFont}" Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/commandhub.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar background spans the title bar too, with a hairline edge -->
        <Border Grid.RowSpan="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,1,0"/>

        <!-- Brand -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="22,0,0,8">
            <Image Source="pack://application:,,,/Assets/commandhub.ico" Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="COMMAND HUB" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Sidebar -->
        <DockPanel Grid.Row="1" Margin="13,12,13,14">
            <RadioButton x:Name="SettingsNav" DockPanel.Dock="Bottom" GroupName="Nav" Style="{StaticResource NavItem}"
                         Checked="Settings_Checked" AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" Width="22"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <!-- Shown when a downloaded update is waiting -->
            <Border x:Name="UpdateCard" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,10"
                    CornerRadius="10" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="UPDATE READY" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="UpdateText" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource AccentButton}" Content="Restart to update" Padding="10,5" HorizontalAlignment="Left"
                            Click="RestartToUpdate_Click" AutomationProperties.Name="Restart to update"/>
                </StackPanel>
            </Border>
            <StackPanel x:Name="PageNav"/>
        </DockPanel>

        <!-- Page area: spans the title bar so each page can paint all the way to the top. -->
        <Grid Grid.RowSpan="2" Grid.Column="1">
            <ContentControl x:Name="PageHost" Focusable="False"/>

            <!-- Window-level sheet (tile picker) and toast (Undo), so they stay on screen while scrolling. -->
            <ContentControl x:Name="Sheet" Focusable="False" Visibility="Collapsed"/>
            <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,24" Padding="16,8,8,8" CornerRadius="10" Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource Strong}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="13"/>
                    <Button x:Name="ToastAction" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Padding="12,5"
                            Click="ToastAction_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="Notice" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="16,44,16,0" Padding="14,9" CornerRadius="10" Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource Strong}" BorderThickness="1" MaxWidth="560">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10"
                            Content="&#xE711;" Click="DismissNotice_Click" AutomationProperties.Name="Dismiss" ToolTip="Dismiss" Margin="10,0,0,0"/>
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Caption buttons sit on top of the page -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="Minimize"
                    ToolTip="Minimize" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" AutomationProperties.Name="Maximize"
                    ToolTip="Maximize" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close"
                    ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
    </Grid>
</Window>
