<UserControl x:Class="CommandHub.Tiles.UnknownTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource IconFont}" FontSize="20"
                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
        <TextBlock Text="This tile needs a newer version of Command hub" TextWrapping="Wrap" TextAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" MaxWidth="220"/>
    </StackPanel>
</UserControl>
