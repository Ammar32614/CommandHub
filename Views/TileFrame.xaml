<UserControl x:Class="CommandHub.Views.TileFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="Card" Background="{DynamicResource Surface}" CornerRadius="14" Padding="14,12,14,14">
            <DockPanel>
                <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource Muted}"
                           Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                <ContentPresenter x:Name="Body"/>
            </DockPanel>
        </Border>
        <!-- Edit-mode layer: blocks tile input and holds the tile controls. -->
        <Border x:Name="EditLayer" Visibility="Collapsed" Background="Transparent" CornerRadius="14"
                BorderThickness="1" BorderBrush="{DynamicResource Strong}" Cursor="SizeAll">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                <Button x:Name="ResizeBtn" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                        Content="&#xE740;" ToolTip="Change size" AutomationProperties.Name="Change size" Cursor="Hand"
                        Background="{DynamicResource Raised}" Margin="0,0,4,0"/>
                <Button x:Name="RemoveBtn" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                        Content="&#xE711;" ToolTip="Remove tile" AutomationProperties.Name="Remove tile" Cursor="Hand"
                        Background="{DynamicResource Raised}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
