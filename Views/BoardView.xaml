<UserControl x:Class="CommandHub.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Layout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel x:Name="Header" Margin="33,10,33,14">
            <Button x:Name="EditBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="Edit_Click"
                    AutomationProperties.Name="Edit layout">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="EditGlyph" Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EditLabel" Text="Edit layout" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer x:Name="BoardScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Canvas x:Name="Board" Margin="33,0,33,28" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>
    </Grid>
</UserControl>
