<UserControl x:Class="CommandHub.Views.AddTilePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource Scrim}" MouseLeftButtonDown="Scrim_MouseDown">
        <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="16" Width="320"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="Card_MouseDown">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="10"
                            Content="&#xE711;" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close picker"/>
                    <TextBlock Text="Add a tile" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel x:Name="Types"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
