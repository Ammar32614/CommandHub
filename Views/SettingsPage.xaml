<UserControl x:Class="CommandHub.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,16,28,28" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>

            <!-- Appearance -->
            <TextBlock Text="Theme" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
            <UniformGrid x:Name="Themes" Columns="3" Margin="-4,0,-4,0"/>
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <DockPanel>
                    <UniformGrid x:Name="TextSize" DockPanel.Dock="Right" Columns="4" Width="260" VerticalAlignment="Center"/>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Text size"/>
                        <TextBlock Text="Makes everything in the window bigger or smaller." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- You -->
            <TextBlock Text="You" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <ContentControl x:Name="NameHost" DockPanel.Dock="Right" Width="260" Focusable="False" VerticalAlignment="Center"/>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Your name"/>
                            <TextBlock x:Name="NameHint" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Margin="0,14,0,14" Background="{DynamicResource Hairline}"/>
                    <TextBlock Text="Open on"/>
                    <TextBlock Text="The tab Command hub shows when it starts." Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                    <Border x:Name="StartPageBox" Padding="3" CornerRadius="9" BorderThickness="1" HorizontalAlignment="Left" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Hairline}">
                        <StackPanel x:Name="StartPage" Orientation="Horizontal"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sidebar -->
            <TextBlock Text="Sidebar" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="TabSwitches"/>
            </Border>

            <!-- Add-ons (filled in by the add-on manager) -->
            <StackPanel x:Name="AddOnsSection"/>

            <!-- Window and startup -->
            <TextBlock Text="Window and startup" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}" AutomationProperties.Name="Start with Windows"
                              Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Start with Windows"/>
                            <TextBlock Text="Opens Command hub minimized when you sign in." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Height="1" Margin="0,14,0,14" Background="{DynamicResource Hairline}"/>
                    <CheckBox x:Name="RememberWindow" Style="{StaticResource Switch}" AutomationProperties.Name="Remember window size"
                              Checked="RememberWindow_Changed" Unchecked="RememberWindow_Changed">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Remember window size and position"/>
                            <TextBlock Text="Reopens where you left it, including maximized." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CheckBtn" Style="{StaticResource GhostButton}" Content="Check for updates" Padding="12,6"
                                    Click="CheckUpdates_Click" AutomationProperties.Name="Check for updates"/>
                            <Button x:Name="RestartBtn" Style="{StaticResource AccentButton}" Content="Restart to update" Padding="12,6"
                                    Margin="8,0,0,0" Visibility="Collapsed" Click="RestartUpdate_Click" AutomationProperties.Name="Restart to update"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="VersionText"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Margin="0,14,0,14" Background="{DynamicResource Hairline}"/>
                    <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" AutomationProperties.Name="Check for updates automatically"
                              Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Check automatically"/>
                            <TextBlock Text="Looks for a new version shortly after starting and every few hours. You always choose when to restart." Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Data -->
            <TextBlock Text="Your data" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Back up now" Padding="12,6" Click="BackUp_Click" AutomationProperties.Name="Back up now"/>
                        <Button Style="{StaticResource GhostButton}" Content="Open folder" Padding="12,6" Margin="8,0,0,0" Click="OpenData_Click" AutomationProperties.Name="Open data folder"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Everything is saved on this PC"/>
                        <TextBlock x:Name="DataText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- About -->
            <Button x:Name="AboutBtn" Margin="0,24,0,0" Click="About_Click" AutomationProperties.Name="About Command hub" Cursor="Hand"
                    FocusVisualStyle="{StaticResource FocusRing}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                        <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/commandhub.png" Width="28" Height="28" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="About Command hub" Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="Version, what's new, credits and where to report a problem." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
